# Copy to .env.local and fill in. Never commit real values.

# ── Next.js (.env.local) ────────────────────────────────────────────
# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Convex deployment env (set with `npx convex env set NAME value`) ──
# These are read by Convex functions and must NOT live in .env.local.
#
# CLERK_JWT_ISSUER_DOMAIN   Clerk "convex" JWT template issuer, e.g. https://your-app.clerk.accounts.dev
# ADMIN_EMAILS              Comma-separated emails promoted to admin on sign-in (Phase 2)
# N8N_WEBHOOK_URL           n8n request-notification webhook, e.g. http://localhost:5678/webhook/loan-notification
# N8N_HMAC_SECRET           Shared secret for signing Convex <-> n8n requests (openssl rand -hex 32)

# ── n8n container (.env.n8n, read by docker-compose.yml) ─────────────
# Kept out of .env.local so Next.js never loads it.
#
# N8N_HMAC_SECRET           Same value as the Convex N8N_HMAC_SECRET
# CONVEX_SITE_URL           Convex HTTP actions as seen from the container: http://host.docker.internal:3211
# ADMIN_ALERT_EMAIL         Receives the error handler's alerts, e.g. admin@lendloop.test
# MAIL_FROM                 From address of every email, e.g. LendLoop <no-reply@lendloop.test>
