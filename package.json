{
  "name": "lend-loop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p convex",
    "sign": "node --experimental-strip-types --no-warnings --env-file=.env.n8n scripts/sign-request.mjs",
    "n8n:import": "docker compose exec -T n8n n8n import:workflow --separate --input=/workflows",
    "n8n:export": "node scripts/n8n-export.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "convex": "^1.49.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.67",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
